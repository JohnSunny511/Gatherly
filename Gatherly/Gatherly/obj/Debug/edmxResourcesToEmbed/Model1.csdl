<?xml version="1.0" encoding="utf-8"?>
<Schema Namespace="GatherlyModel" Alias="Self" annotation:UseStrongSpatialTypes="false" xmlns:annotation="http://schemas.microsoft.com/ado/2009/02/edm/annotation" xmlns:customannotation="http://schemas.microsoft.com/ado/2013/11/edm/customannotation" xmlns="http://schemas.microsoft.com/ado/2009/11/edm">
  <EntityType Name="login">
    <Key>
      <PropertyRef Name="login_id" />
    </Key>
    <Property Name="login_id" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="username" Type="String" MaxLength="50" FixedLength="false" Unicode="true" Nullable="false" />
    <Property Name="password" Type="String" MaxLength="255" FixedLength="false" Unicode="true" Nullable="false" />
    <Property Name="user_type" Type="String" MaxLength="20" FixedLength="false" Unicode="true" Nullable="false" />
    <Property Name="reg_id" Type="Int32" Nullable="false" />
  </EntityType>
  <EntityType Name="user">
    <Key>
      <PropertyRef Name="user_id" />
    </Key>
    <Property Name="user_id" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="user_name" Type="String" MaxLength="50" FixedLength="false" Unicode="false" Nullable="false" />
    <Property Name="user_age" Type="Int32" Nullable="false" />
    <Property Name="user_phone" Type="Decimal" Precision="18" Scale="0" Nullable="false" />
    <Property Name="user_email" Type="String" MaxLength="50" FixedLength="false" Unicode="false" Nullable="false" />
    <Property Name="user_addr" Type="String" MaxLength="150" FixedLength="false" Unicode="false" Nullable="false" />
    <Property Name="user_photo" Type="String" MaxLength="250" FixedLength="false" Unicode="false" Nullable="false" />
    <Property Name="user_status" Type="String" MaxLength="50" FixedLength="false" Unicode="false" Nullable="false" />
    <NavigationProperty Name="venue_booking" Relationship="GatherlyModel.FK_venue_booking_user" FromRole="user" ToRole="venue_booking" />
  </EntityType>
  <EntityType Name="venue">
    <Key>
      <PropertyRef Name="venue_id" />
    </Key>
    <Property Name="venue_id" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="owner_id" Type="Int32" Nullable="false" />
    <Property Name="venue_name" Type="String" MaxLength="150" FixedLength="false" Unicode="true" Nullable="false" />
    <Property Name="location" Type="String" MaxLength="255" FixedLength="false" Unicode="true" Nullable="false" />
    <Property Name="capacity" Type="Int32" Nullable="false" />
    <Property Name="price" Type="Decimal" Precision="12" Scale="2" Nullable="false" />
    <Property Name="venue_type" Type="String" MaxLength="50" FixedLength="false" Unicode="true" Nullable="false" />
    <Property Name="catering" Type="Boolean" Nullable="false" />
    <Property Name="parking" Type="Boolean" Nullable="false" />
    <Property Name="ac" Type="Boolean" Nullable="false" />
    <Property Name="description" Type="String" MaxLength="Max" FixedLength="false" Unicode="true" Nullable="false" />
    <Property Name="available_from" Type="DateTime" Precision="3" Nullable="false" />
    <Property Name="available_to" Type="DateTime" Precision="3" Nullable="false" />
    <Property Name="venue_status" Type="String" MaxLength="20" FixedLength="false" Unicode="true" Nullable="false" />
    <Property Name="venue_image" Type="String" MaxLength="500" FixedLength="false" Unicode="true" Nullable="false" />
    <NavigationProperty Name="venue_booking" Relationship="GatherlyModel.FK_venue_booking_venue" FromRole="venue" ToRole="venue_booking" />
  </EntityType>
  <EntityContainer Name="GatherlyEntities" annotation:LazyLoadingEnabled="true">
    <EntitySet Name="logins" EntityType="Self.login" />
    <EntitySet Name="users" EntityType="Self.user" />
    <EntitySet Name="venues" EntityType="Self.venue" />
    <FunctionImport Name="adminreg">
      <Parameter Name="oid" Mode="In" Type="Int32" />
      <Parameter Name="ona" Mode="In" Type="String" />
      <Parameter Name="oemail" Mode="In" Type="String" />
      <Parameter Name="ophone" Mode="In" Type="String" />
      <Parameter Name="oaddr" Mode="In" Type="String" />
      <Parameter Name="ophoto" Mode="In" Type="String" />
    </FunctionImport>
    <EntitySet Name="owners" EntityType="GatherlyModel.owner" />
    <FunctionImport Name="sp_ownerreg">
      <Parameter Name="oid" Mode="In" Type="Int32" />
      <Parameter Name="ona" Mode="In" Type="String" />
      <Parameter Name="oemail" Mode="In" Type="String" />
      <Parameter Name="ophone" Mode="In" Type="String" />
      <Parameter Name="oaddr" Mode="In" Type="String" />
      <Parameter Name="ophoto" Mode="In" Type="String" />
    </FunctionImport>
    <FunctionImport Name="sp_maxLogId" ReturnType="Collection(Int32)" />
    <FunctionImport Name="sp_LoginInsert">
      <Parameter Name="rid" Mode="In" Type="Int32" />
      <Parameter Name="una" Mode="In" Type="String" />
      <Parameter Name="pw" Mode="In" Type="String" />
      <Parameter Name="utype" Mode="In" Type="String" />
    </FunctionImport>
    <FunctionImport Name="sp_userreg">
      <Parameter Name="uid" Mode="In" Type="Int32" />
      <Parameter Name="unam" Mode="In" Type="String" />
      <Parameter Name="uage" Mode="In" Type="Int32" />
      <Parameter Name="uphone" Mode="In" Type="String" />
      <Parameter Name="uemail" Mode="In" Type="String" />
      <Parameter Name="uaddr" Mode="In" Type="String" />
      <Parameter Name="uphoto" Mode="In" Type="String" />
    </FunctionImport>
    <FunctionImport Name="sp_venueinsert">
      <Parameter Name="ownerid" Mode="In" Type="Int32" />
      <Parameter Name="vname" Mode="In" Type="String" />
      <Parameter Name="location" Mode="In" Type="String" />
      <Parameter Name="capacity" Mode="In" Type="Int32" />
      <Parameter Name="price" Mode="In" Type="Decimal" />
      <Parameter Name="venuetype" Mode="In" Type="String" />
      <Parameter Name="description" Mode="In" Type="String" />
      <Parameter Name="availablefrom" Mode="In" Type="DateTime" />
      <Parameter Name="availableto" Mode="In" Type="DateTime" />
      <Parameter Name="venueimage" Mode="In" Type="String" />
    </FunctionImport>
    <FunctionImport Name="sp_UserViewVenue" ReturnType="Collection(GatherlyModel.sp_UserViewVenue_Result)" />
    <FunctionImport Name="sp_login" ReturnType="Collection(GatherlyModel.sp_login_Result)">
      <Parameter Name="una" Mode="In" Type="String" />
      <Parameter Name="pwd" Mode="In" Type="String" />
    </FunctionImport>
    <EntitySet Name="venue_booking" EntityType="GatherlyModel.venue_booking" />
    <AssociationSet Name="FK_venue_booking_user" Association="GatherlyModel.FK_venue_booking_user">
      <End Role="user" EntitySet="users" />
      <End Role="venue_booking" EntitySet="venue_booking" />
    </AssociationSet>
    <AssociationSet Name="FK_venue_booking_venue" Association="GatherlyModel.FK_venue_booking_venue">
      <End Role="venue" EntitySet="venues" />
      <End Role="venue_booking" EntitySet="venue_booking" />
    </AssociationSet>
    <FunctionImport Name="SP_CheckVenueBooking" ReturnType="Collection(Int32)">
      <Parameter Name="venue_id" Mode="In" Type="Int32" />
      <Parameter Name="event_date" Mode="In" Type="DateTime" />
    </FunctionImport>
    <FunctionImport Name="SP_GetBookedDates" ReturnType="Collection(DateTime)">
      <Parameter Name="venue_id" Mode="In" Type="Int32" />
    </FunctionImport>
    <FunctionImport Name="SP_InsertVenueBooking">
      <Parameter Name="user_id" Mode="In" Type="Int32" />
      <Parameter Name="venue_id" Mode="In" Type="Int32" />
      <Parameter Name="event_date" Mode="In" Type="DateTime" />
      <Parameter Name="guest_count" Mode="In" Type="Int32" />
      <Parameter Name="event_type" Mode="In" Type="String" />
      <Parameter Name="requirements" Mode="In" Type="String" />
    </FunctionImport>
  </EntityContainer>
  <EntityType Name="owner">
    <Key>
      <PropertyRef Name="owner_id" />
    </Key>
    <Property Name="owner_id" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="owner_name" Type="String" Nullable="false" MaxLength="50" FixedLength="false" Unicode="false" />
    <Property Name="owner_email" Type="String" Nullable="false" MaxLength="50" FixedLength="false" Unicode="false" />
    <Property Name="owner_phone" Type="Decimal" Nullable="false" Precision="18" Scale="0" />
    <Property Name="owner_address" Type="String" Nullable="false" MaxLength="150" FixedLength="false" Unicode="false" />
    <Property Name="owner_photo" Type="String" Nullable="false" MaxLength="250" FixedLength="false" Unicode="false" />
    <Property Name="owner_status" Type="Int32" Nullable="false" />
  </EntityType>
  <ComplexType Name="sp_UserViewVenue_Result">
    <Property Type="Int32" Name="venue_id" Nullable="false" />
    <Property Type="String" Name="venue_image" Nullable="true" MaxLength="500" />
    <Property Type="String" Name="venue_name" Nullable="false" MaxLength="150" />
    <Property Type="String" Name="location" Nullable="true" MaxLength="255" />
    <Property Type="Int32" Name="capacity" Nullable="true" />
    <Property Type="Decimal" Name="price" Nullable="true" Precision="12" Scale="2" />
    <Property Type="String" Name="venue_type" Nullable="true" MaxLength="50" />
  </ComplexType>
  <ComplexType Name="sp_login_Result">
    <Property Type="Int32" Name="reg_id" Nullable="false" />
    <Property Type="String" Name="user_type" Nullable="false" MaxLength="20" />
  </ComplexType>
  <EntityType Name="venue_booking">
    <Key>
      <PropertyRef Name="booking_id" />
    </Key>
    <Property Name="booking_id" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="user_id" Type="Int32" Nullable="false" />
    <Property Name="venue_id" Type="Int32" Nullable="false" />
    <Property Name="event_date" Type="DateTime" Nullable="false" Precision="0" />
    <Property Name="guest_count" Type="Int32" Nullable="false" />
    <Property Name="event_type" Type="String" Nullable="false" MaxLength="50" FixedLength="false" Unicode="true" />
    <Property Name="requirements" Type="String" Nullable="false" MaxLength="Max" FixedLength="false" Unicode="true" />
    <Property Name="booking_date" Type="DateTime" Nullable="false" Precision="3" />
    <Property Name="booking_status" Type="String" Nullable="false" MaxLength="30" FixedLength="false" Unicode="true" />
    <NavigationProperty Name="user" Relationship="GatherlyModel.FK_venue_booking_user" FromRole="venue_booking" ToRole="user" />
    <NavigationProperty Name="venue" Relationship="GatherlyModel.FK_venue_booking_venue" FromRole="venue_booking" ToRole="venue" />
  </EntityType>
  <Association Name="FK_venue_booking_user">
    <End Type="GatherlyModel.user" Role="user" Multiplicity="1" />
    <End Type="GatherlyModel.venue_booking" Role="venue_booking" Multiplicity="*" />
    <ReferentialConstraint>
      <Principal Role="user">
        <PropertyRef Name="user_id" />
      </Principal>
      <Dependent Role="venue_booking">
        <PropertyRef Name="user_id" />
      </Dependent>
    </ReferentialConstraint>
  </Association>
  <Association Name="FK_venue_booking_venue">
    <End Type="GatherlyModel.venue" Role="venue" Multiplicity="1" />
    <End Type="GatherlyModel.venue_booking" Role="venue_booking" Multiplicity="*" />
    <ReferentialConstraint>
      <Principal Role="venue">
        <PropertyRef Name="venue_id" />
      </Principal>
      <Dependent Role="venue_booking">
        <PropertyRef Name="venue_id" />
      </Dependent>
    </ReferentialConstraint>
  </Association>
</Schema>