<?xml version="1.0" encoding="utf-8"?>
<Schema Namespace="GatherlyModel" Alias="Self" annotation:UseStrongSpatialTypes="false" xmlns:annotation="http://schemas.microsoft.com/ado/2009/02/edm/annotation" xmlns:customannotation="http://schemas.microsoft.com/ado/2013/11/edm/customannotation" xmlns="http://schemas.microsoft.com/ado/2009/11/edm">
  <EntityType Name="login">
    <Key>
      <PropertyRef Name="login_id" />
    </Key>
    <Property Name="login_id" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="username" Type="String" MaxLength="50" FixedLength="false" Unicode="true" Nullable="false" />
    <Property Name="password" Type="String" MaxLength="255" FixedLength="false" Unicode="true" Nullable="false" />
    <Property Name="user_type" Type="String" MaxLength="20" FixedLength="false" Unicode="true" Nullable="false" />
    <Property Name="reg_id" Type="Int32" Nullable="false" />
  </EntityType>
  <EntityType Name="user">
    <Key>
      <PropertyRef Name="user_id" />
    </Key>
    <Property Name="user_id" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="user_name" Type="String" MaxLength="50" FixedLength="false" Unicode="false" Nullable="false" />
    <Property Name="user_age" Type="Int32" Nullable="false" />
    <Property Name="user_phone" Type="Decimal" Precision="18" Scale="0" Nullable="false" />
    <Property Name="user_email" Type="String" MaxLength="50" FixedLength="false" Unicode="false" Nullable="false" />
    <Property Name="user_addr" Type="String" MaxLength="150" FixedLength="false" Unicode="false" Nullable="false" />
    <Property Name="user_photo" Type="String" MaxLength="250" FixedLength="false" Unicode="false" Nullable="false" />
    <Property Name="user_status" Type="String" MaxLength="50" FixedLength="false" Unicode="false" Nullable="false" />
  </EntityType>
  <EntityType Name="venue">
    <Key>
      <PropertyRef Name="venue_id" />
    </Key>
    <Property Name="venue_id" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="owner_id" Type="Int32" Nullable="false" />
    <Property Name="venue_name" Type="String" MaxLength="150" FixedLength="false" Unicode="true" Nullable="false" />
    <Property Name="location" Type="String" MaxLength="255" FixedLength="false" Unicode="true" />
    <Property Name="capacity" Type="Int32" />
    <Property Name="price" Type="Decimal" Precision="12" Scale="2" />
    <Property Name="venue_type" Type="String" MaxLength="50" FixedLength="false" Unicode="true" />
    <Property Name="catering" Type="Boolean" />
    <Property Name="parking" Type="Boolean" />
    <Property Name="ac" Type="Boolean" />
    <Property Name="description" Type="String" MaxLength="Max" FixedLength="false" Unicode="true" />
    <Property Name="available_from" Type="DateTime" Precision="3" />
    <Property Name="available_to" Type="DateTime" Precision="3" />
    <Property Name="venue_status" Type="String" MaxLength="20" FixedLength="false" Unicode="true" />
    <Property Name="venue_image" Type="String" MaxLength="500" FixedLength="false" Unicode="true" />
  </EntityType>
  <EntityContainer Name="GatherlyEntities" annotation:LazyLoadingEnabled="true">
    <EntitySet Name="logins" EntityType="Self.login" />
    <EntitySet Name="users" EntityType="Self.user" />
    <EntitySet Name="venues" EntityType="Self.venue" />
    <FunctionImport Name="adminreg">
      <Parameter Name="oid" Mode="In" Type="Int32" />
      <Parameter Name="ona" Mode="In" Type="String" />
      <Parameter Name="oemail" Mode="In" Type="String" />
      <Parameter Name="ophone" Mode="In" Type="String" />
      <Parameter Name="oaddr" Mode="In" Type="String" />
      <Parameter Name="ophoto" Mode="In" Type="String" />
    </FunctionImport>
    <EntitySet Name="owners" EntityType="GatherlyModel.owner" />
    <FunctionImport Name="sp_ownerreg">
      <Parameter Name="oid" Mode="In" Type="Int32" />
      <Parameter Name="ona" Mode="In" Type="String" />
      <Parameter Name="oemail" Mode="In" Type="String" />
      <Parameter Name="ophone" Mode="In" Type="String" />
      <Parameter Name="oaddr" Mode="In" Type="String" />
      <Parameter Name="ophoto" Mode="In" Type="String" />
    </FunctionImport>
    <FunctionImport Name="sp_maxLogId" ReturnType="Collection(Int32)" />
    <FunctionImport Name="sp_LoginInsert">
      <Parameter Name="rid" Mode="In" Type="Int32" />
      <Parameter Name="una" Mode="In" Type="String" />
      <Parameter Name="pw" Mode="In" Type="String" />
      <Parameter Name="utype" Mode="In" Type="String" />
    </FunctionImport>
    <FunctionImport Name="sp_userreg">
      <Parameter Name="uid" Mode="In" Type="Int32" />
      <Parameter Name="unam" Mode="In" Type="String" />
      <Parameter Name="uage" Mode="In" Type="Int32" />
      <Parameter Name="uphone" Mode="In" Type="String" />
      <Parameter Name="uemail" Mode="In" Type="String" />
      <Parameter Name="uaddr" Mode="In" Type="String" />
      <Parameter Name="uphoto" Mode="In" Type="String" />
    </FunctionImport>
    <FunctionImport Name="sp_venueinsert">
      <Parameter Name="ownerid" Mode="In" Type="Int32" />
      <Parameter Name="vname" Mode="In" Type="String" />
      <Parameter Name="location" Mode="In" Type="String" />
      <Parameter Name="capacity" Mode="In" Type="Int32" />
      <Parameter Name="price" Mode="In" Type="Decimal" />
      <Parameter Name="venuetype" Mode="In" Type="String" />
      <Parameter Name="description" Mode="In" Type="String" />
      <Parameter Name="availablefrom" Mode="In" Type="DateTime" />
      <Parameter Name="availableto" Mode="In" Type="DateTime" />
      <Parameter Name="venueimage" Mode="In" Type="String" />
    </FunctionImport>
    <FunctionImport Name="sp_login" ReturnType="Collection(Int32)">
      <Parameter Name="una" Mode="In" Type="String" />
      <Parameter Name="pwd" Mode="In" Type="String" />
    </FunctionImport>
  </EntityContainer>
  <EntityType Name="owner">
    <Key>
      <PropertyRef Name="owner_id" />
    </Key>
    <Property Name="owner_id" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="owner_name" Type="String" Nullable="false" MaxLength="50" FixedLength="false" Unicode="false" />
    <Property Name="owner_email" Type="String" Nullable="false" MaxLength="50" FixedLength="false" Unicode="false" />
    <Property Name="owner_phone" Type="Decimal" Nullable="false" Precision="18" Scale="0" />
    <Property Name="owner_address" Type="String" Nullable="false" MaxLength="150" FixedLength="false" Unicode="false" />
    <Property Name="owner_photo" Type="String" Nullable="false" MaxLength="250" FixedLength="false" Unicode="false" />
    <Property Name="owner_status" Type="Int32" Nullable="false" />
  </EntityType>
</Schema>